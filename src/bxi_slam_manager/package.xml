<?xml version="1.0"?>
<package format="3">
  <name>bxi_slam_manager</name>
  <version>0.1.0</version>
  <description>Quiet-boot runtime supervisor for indoor SLAM modes.</description>
  <maintainer email="dev@bxirobotics.cn">BXI Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>bxi_nav_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>point_lio</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>small_gicp_relocalization</exec_depend>
